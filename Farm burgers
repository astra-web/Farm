--==================================================
-- GHOST MODE
--==================================================

local function setGhostMode(state)

	local character = player.Character

	if not character then
		return
	end

	if state then

		for _,part in ipairs(character:GetDescendants()) do

			if part:IsA("BasePart")
				or part:IsA("Decal") then

				if part.Name ~= "HumanoidRootPart" then

					if originalTransparencies[part] == nil then
						originalTransparencies[part] =
							part.Transparency
					end

					part.Transparency = 0.5
				end
			end
		end

	else

		for part,transparency in pairs(
			originalTransparencies
		) do

			if part and part.Parent then
				part.Transparency = transparency
			end
		end

		table.clear(originalTransparencies)
	end
end

--==================================================
-- GHOST FLY
--==================================================

local function startGhostFly()

	local character = player.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local head =
		character:FindFirstChild("Head")

	local hrp =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not head or not hrp then
		return
	end

	startPos = hrp.CFrame

	if bodyClone then
		bodyClone:Destroy()
	end

	character.Archivable = true

	bodyClone = character:Clone()
	bodyClone.Name = "GhostFlyVessel"

	for _,object in ipairs(
		bodyClone:GetDescendants()
	) do

		if object:IsA("BasePart") then
			object.Anchored = true
			object.CanCollide = false

		elseif object:IsA("Script")
			or object:IsA("LocalScript") then

			object:Destroy()
		end
	end

	bodyClone.Parent = workspace
	bodyClone:PivotTo(startPos)

	humanoid.PlatformStand = true
	head.Anchored = true

	setGhostMode(true)

	if ghostLoop then
		ghostLoop:Disconnect()
	end

	ghostLoop =
		RunService.Heartbeat:Connect(function(deltaTime)

			if not ghostFlyEnabled then
				return
			end

			if not character.Parent then
				return
			end

			local moveDirection =
				humanoid.MoveDirection
				* (flySpeed * deltaTime)

			local headCFrame = head.CFrame
			local camera = workspace.CurrentCamera
			local cameraCFrame = camera.CFrame

			local cameraOffset =
				headCFrame:ToObjectSpace(
					cameraCFrame
				).Position

			cameraCFrame =
				cameraCFrame *
				CFrame.new(
					-cameraOffset.X,
					-cameraOffset.Y,
					-cameraOffset.Z + 1
				)

			local cameraPosition =
				cameraCFrame.Position

			local headPosition =
				headCFrame.Position

			local objectSpaceVelocity =
				CFrame.new(
					cameraPosition,
					Vector3.new(
						headPosition.X,
						cameraPosition.Y,
						headPosition.Z
					)
				):VectorToObjectSpace(
					moveDirection
				)

			head.CFrame =
				CFrame.new(headPosition)
				* (cameraCFrame-cameraPosition)
				* CFrame.new(objectSpaceVelocity)
		end)
end

local function stopGhostFly()

	if ghostLoop then
		ghostLoop:Disconnect()
		ghostLoop = nil
	end

	local character = player.Character

	if character then

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		local head =
			character:FindFirstChild("Head")

		if humanoid then
			humanoid.PlatformStand = false
		end

		if head then
			head.Anchored = false
		end
	end

	setGhostMode(false)

	if bodyClone then
		bodyClone:Destroy()
		bodyClone = nil
	end
end

--==================================================
-- NORMAL MOBILE FLY
--==================================================

local function startNormalFly()

	local character = player.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local hrp =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		return
	end

	-- На всякий случай удаляем старые объекты Fly
	local oldVelocity =
		hrp:FindFirstChild("AstraMobileFlyVelocity")

	local oldGyro =
		hrp:FindFirstChild("AstraMobileFlyGyro")

	if oldVelocity then
		oldVelocity:Destroy()
	end

	if oldGyro then
		oldGyro:Destroy()
	end

	local bodyVelocity = Instance.new("BodyVelocity")

	bodyVelocity.Name =
		"AstraMobileFlyVelocity"

	bodyVelocity.MaxForce =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	bodyVelocity.Velocity =
		Vector3.zero

	bodyVelocity.Parent = hrp

	local bodyGyro = Instance.new("BodyGyro")

	bodyGyro.Name =
		"AstraMobileFlyGyro"

	bodyGyro.MaxTorque =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	bodyGyro.P = 90000
	bodyGyro.CFrame = hrp.CFrame
	bodyGyro.Parent = hrp

	humanoid.PlatformStand = true

	if flyLoop then
		flyLoop:Disconnect()
	end

	flyLoop =
		RunService.RenderStepped:Connect(function()

			if not normalFlyEnabled then
				return
			end

			if not character.Parent then
				return
			end

			local camera =
				workspace.CurrentCamera

			-- Стандартный Roblox мобильный джойстик
			local moveDirection =
				humanoid.MoveDirection

			if moveDirection.Magnitude > 0.05 then

				bodyVelocity.Velocity =
					moveDirection.Unit
					* flySpeed

			else

				bodyVelocity.Velocity =
					Vector3.zero
			end

			-- Поворот персонажа в сторону камеры
			local look =
				camera.CFrame.LookVector

			local horizontalLook =
				Vector3.new(
					look.X,
					0,
					look.Z
				)

			if horizontalLook.Magnitude > 0.01 then

				bodyGyro.CFrame =
					CFrame.lookAt(
						hrp.Position,
						hrp.Position +
							horizontalLook.Unit
					)
			end
		end)
end

local function stopNormalFly()

	if flyLoop then
		flyLoop:Disconnect()
		flyLoop = nil
	end

	local character =
		player.Character

	if character then

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		local hrp =
			character:FindFirstChild(
				"HumanoidRootPart"
			)

		if humanoid then
			humanoid.PlatformStand = false
		end

		if hrp then

			local velocity =
				hrp:FindFirstChild(
					"AstraMobileFlyVelocity"
				)

			local gyro =
				hrp:FindFirstChild(
					"AstraMobileFlyGyro"
				)

			if velocity then
				velocity:Destroy()
			end

			if gyro then
				gyro:Destroy()
			end
		end
	end
end

