farmButton.MouseButton1Click:Connect(function()
	farmEnabled = not farmEnabled
	farmButton.Text = farmEnabled
		and "Farm: Включено ✅"
		or "Farm: Выключено ❎"
end)

local function setNoclip(state)
	noclipEnabled = state

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	if noclipEnabled then
		noclipConnection = RunService.Stepped:Connect(function()
			local character = player.Character

			if character then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end)
	else
		local character = player.Character

		if character then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = true
				end
			end
		end
	end

	noclipButton.Text = noclipEnabled
		and "Noclip: Включено ✅"
		or "Noclip: Выключено ❎"
end

noclipButton.MouseButton1Click:Connect(function()
	setNoclip(not noclipEnabled)
end)

-- Перетаскивание UI
local dragging = false
local dragStart
local startPos

frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then

		local delta = input.Position - dragStart

		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

local function getTargets()
	local targets = {}

	for _, obj in ipairs(workspace:GetDescendants()) do
		if (obj:IsA("BasePart") or obj:IsA("Model"))
			and table.find(targetNames, obj.Name) then
			table.insert(targets, obj)
		end
	end

	return targets
end

local function teleportWithoutTurning(character, target)
	local camera = workspace.CurrentCamera
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	local oldCharacterCFrame = character:GetPivot()
	local oldCameraCFrame = camera.CFrame
	local oldCameraType = camera.CameraType
	local oldAutoRotate = humanoid.AutoRotate

	humanoid.AutoRotate = false

	local targetPosition = target:GetPivot().Position
	local rotationOnly = oldCharacterCFrame - oldCharacterCFrame.Position

	character:PivotTo(
		CFrame.new(targetPosition + Vector3.new(0, 4, 0)) * rotationOnly
	)

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = oldCameraCFrame

	local connection = RunService.RenderStepped:Connect(function()
		if camera and camera.Parent then
			camera.CFrame = oldCameraCFrame
		end
	end)

	task.wait(0.7)

	connection:Disconnect()

	if character.Parent then
		character:PivotTo(oldCharacterCFrame)

		camera.CFrame = oldCameraCFrame
		camera.CameraType = oldCameraType

		humanoid.AutoRotate = oldAutoRotate
	end
end

task.spawn(function()
	while true do
		if farmEnabled then
			local character = player.Character

			if character then
				local targets = getTargets()

				for _, target in ipairs(targets) do
					if not farmEnabled then
						break
					end

					if target.Parent then
						teleportWithoutTurning(character, target)
						task.wait(0.7)
					end
				end
			end
		end

		task.wait(0.2)
	end
end)

player.CharacterAdded:Connect(function()
	if noclipEnabled then
		task.wait(0.5)
	end
end)
