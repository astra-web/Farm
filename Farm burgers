local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local enabled = false

local targetNames = {
	"FireCrateCurrency",
	"Burger"
}

local gui = Instance.new("ScreenGui")
gui.Name = "FarmUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 120)
frame.Position = UDim2.new(0.5, -130, 0.5, -60)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.Active = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 45)
title.BackgroundTransparency = 1
title.Text = "Farm 💎 Crystal / 🍔 Burger"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.new(0.85, 0, 0, 45)
button.Position = UDim2.new(0.075, 0, 0, 60)
button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
button.Text = "Выключено ❎"
button.TextColor3 = Color3.new(1, 1, 1)
button.TextSize = 17
button.Font = Enum.Font.GothamBold
button.Parent = frame

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 10)
buttonCorner.Parent = button

button.MouseButton1Click:Connect(function()
	enabled = not enabled
	button.Text = enabled and "Включено ✅" or "Выключено ❎"
end)

local dragging = false
local dragStart
local startPos

frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then

		local delta = input.Position - dragStart

		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

local function getTargets()
	local targets = {}

	for _, obj in ipairs(workspace:GetDescendants()) do
		if (obj:IsA("BasePart") or obj:IsA("Model"))
			and table.find(targetNames, obj.Name) then

			table.insert(targets, obj)
		end
	end

	return targets
end

local function teleportWithoutTurning(character, target)
	local camera = workspace.CurrentCamera
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	local oldCharacterCFrame = character:GetPivot()
	local oldCameraCFrame = camera.CFrame
	local oldCameraType = camera.CameraType
	local oldAutoRotate = humanoid.AutoRotate

	humanoid.AutoRotate = false

	local targetPosition = target:GetPivot().Position
	local rotationOnly = oldCharacterCFrame - oldCharacterCFrame.Position

	character:PivotTo(
		CFrame.new(targetPosition + Vector3.new(0, 4, 0)) * rotationOnly
	)

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = oldCameraCFrame

	local connection = RunService.RenderStepped:Connect(function()
		if camera and camera.Parent then
			camera.CFrame = oldCameraCFrame
		end
	end)

	task.wait(0.7)

	if connection then
		connection:Disconnect()
	end

	if character.Parent then
		character:PivotTo(oldCharacterCFrame)

		camera.CFrame = oldCameraCFrame
		camera.CameraType = oldCameraType

		humanoid.AutoRotate = oldAutoRotate
	end
end

task.spawn(function()
	while true do
		if enabled then
			local character = player.Character

			if character then
				local targets = getTargets()

				for _, target in ipairs(targets) do
					if not enabled then
						break
					end

					if target.Parent then
						teleportWithoutTurning(character, target)
						task.wait(0.7)
					end
				end
			end
		end

		task.wait(0.2)
	end
end)
