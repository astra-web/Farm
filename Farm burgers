--==================================================
-- GHOST TRANSPARENCY
--==================================================

local function setTransparency(enabled)

	local char = getCharacter()

	if enabled then

		for _,obj in ipairs(char:GetDescendants()) do

			if obj:IsA("BasePart") or obj:IsA("Decal") then

				if obj.Name ~= "HumanoidRootPart" then

					if originalTransparency[obj] == nil then
						originalTransparency[obj] = obj.Transparency
					end

					obj.Transparency = .5
				end
			end
		end

	else

		for obj,value in pairs(originalTransparency) do

			if obj and obj.Parent then
				obj.Transparency = value
			end
		end

		table.clear(originalTransparency)
	end
end

--==================================================
-- GHOST FLY
--==================================================

local function stopGhostFly()

	ghostFlyEnabled = false

	if ghostLoop then
		ghostLoop:Disconnect()
		ghostLoop = nil
	end

	local char = player.Character

	if char then

		local hum = char:FindFirstChildOfClass("Humanoid")
		local head = char:FindFirstChild("Head")

		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true
		end

		if head then
			head.Anchored = false
		end

		-- Возвращаемся именно туда,
		-- где было оставлено тело
		if ghostStartCFrame then
			char:PivotTo(ghostStartCFrame)
		end
	end

	setTransparency(false)

	if ghostBody then
		ghostBody:Destroy()
		ghostBody = nil
	end
end

local function startGhostFly()

	local char = getCharacter()
	local hum = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if not hum or not head or not hrp then
		return
	end

	ghostStartCFrame = char:GetPivot()

	if ghostBody then
		ghostBody:Destroy()
	end

	char.Archivable = true

	ghostBody = char:Clone()
	ghostBody.Name = "GhostBody"

	for _,obj in ipairs(ghostBody:GetDescendants()) do

		if obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide = false

		elseif obj:IsA("Script")
			or obj:IsA("LocalScript") then

			obj:Destroy()
		end
	end

	ghostBody.Parent = workspace
	ghostBody:PivotTo(ghostStartCFrame)

	hum.PlatformStand = true
	hum.AutoRotate = false
	head.Anchored = true

	setTransparency(true)

	ghostFlyEnabled = true

	if ghostLoop then
		ghostLoop:Disconnect()
	end

	ghostLoop = RunService.RenderStepped:Connect(function()

		if not ghostFlyEnabled then
			return
		end

		if not char.Parent then
			return
		end

		local camera = workspace.CurrentCamera
		local move = hum.MoveDirection

		local velocity = Vector3.zero

		if move.Magnitude > .05 then
			velocity = move.Unit * flySpeed
		end

		local look = camera.CFrame.LookVector

		-- Наклон камеры задаёт вертикальное движение
		local vertical = look.Y * flySpeed

		velocity += Vector3.new(
			0,
			vertical,
			0
		)

		head.CFrame =
			head.CFrame
			+ velocity * RunService.RenderStepped:Wait()
	end)
end

--==================================================
-- NORMAL FLY
--==================================================

local function stopNormalFly()

	normalFlyEnabled = false

	if flyLoop then
		flyLoop:Disconnect()
		flyLoop = nil
	end

	local char = player.Character

	if char then

		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")

		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true
		end

		if root then

			local velocity =
				root:FindFirstChild("AstraFlyVelocity")

			local gyro =
				root:FindFirstChild("AstraFlyGyro")

			if velocity then
				velocity:Destroy()
			end

			if gyro then
				gyro:Destroy()
			end
		end
	end
end

local function startNormalFly()

	local char = getCharacter()
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")

	if not hum or not root then
		return
	end

	local velocity = Instance.new("BodyVelocity")
	velocity.Name = "AstraFlyVelocity"
	velocity.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
	velocity.Velocity = Vector3.zero
	velocity.Parent = root

	local gyro = Instance.new("BodyGyro")
	gyro.Name = "AstraFlyGyro"
	gyro.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)
	gyro.P = 90000
	gyro.CFrame = root.CFrame
	gyro.Parent = root

	hum.PlatformStand = true
	hum.AutoRotate = false

	normalFlyEnabled = true

	if flyLoop then
		flyLoop:Disconnect()
	end

	flyLoop = RunService.RenderStepped:Connect(function()

		if not normalFlyEnabled then
			return
		end

		local camera = workspace.CurrentCamera

		-- Стандартный Roblox-мобильный джойстик
		local move = hum.MoveDirection

		-- Вертикаль зависит от наклона камеры
		local vertical = camera.CFrame.LookVector.Y

		local result = Vector3.new(
			move.X,
			vertical,
			move.Z
		)

		if result.Magnitude > .05 then
			result = result.Unit * flySpeed
		else
			result = Vector3.zero
		end

		velocity.Velocity = result

		-- Поворот персонажа по направлению камеры
		local look = camera.CFrame.LookVector

		local horizontal =
			Vector3.new(look.X,0,look.Z)

		if horizontal.Magnitude > .01 then

			gyro.CFrame =
				CFrame.lookAt(
					root.Position,
					root.Position + horizontal.Unit
				)
		end
	end)
end

