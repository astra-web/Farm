--==================================================
-- TARGETS
--==================================================

local function getTargets()

	local targets = {}

	for _,object in ipairs(
		workspace:GetDescendants()
	) do

		if (
			object:IsA("BasePart")
			or object:IsA("Model")
		)
		and table.find(
			targetNames,
			object.Name
		) then

			table.insert(
				targets,
				object
			)
		end
	end

	return targets
end

--==================================================
-- TELEPORT WITHOUT TURNING
--==================================================

local function teleportWithoutTurning(
	character,
	target
)

	local camera =
		workspace.CurrentCamera

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then
		return
	end

	local oldCharacterCFrame =
		character:GetPivot()

	local oldCameraCFrame =
		camera.CFrame

	local oldCameraType =
		camera.CameraType

	local oldAutoRotate =
		humanoid.AutoRotate

	humanoid.AutoRotate = false

	local targetPosition =
		target:GetPivot().Position

	local rotationOnly =
		oldCharacterCFrame
		- oldCharacterCFrame.Position

	character:PivotTo(
		CFrame.new(
			targetPosition +
				Vector3.new(0,4,0)
		)
		* rotationOnly
	)

	camera.CameraType =
		Enum.CameraType.Scriptable

	camera.CFrame =
		oldCameraCFrame

	local connection =
		RunService.RenderStepped:Connect(
			function()

				if camera and camera.Parent then
					camera.CFrame =
						oldCameraCFrame
				end
			end
		)

	task.wait(0.7)

	connection:Disconnect()

	if character.Parent then

		character:PivotTo(
			oldCharacterCFrame
		)

		camera.CFrame =
			oldCameraCFrame

		camera.CameraType =
			oldCameraType

		humanoid.AutoRotate =
			oldAutoRotate
	end
end

--==================================================
-- FARM LOOP
--==================================================

task.spawn(function()

	while true do

		if farmEnabled then

			local character =
				player.Character

			if character then

				local targets =
					getTargets()

				for _,target in ipairs(targets) do

					if not farmEnabled then
						break
					end

					if target.Parent then

						teleportWithoutTurning(
							character,
							target
						)

						task.wait(0.7)
					end
				end
			end
		end

		task.wait(0.2)
	end
end)

