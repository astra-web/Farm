--==================================================
-- FARM
--==================================================

local function getTargets()

	local result = {}

	for _,obj in ipairs(workspace:GetDescendants()) do

		if table.find(targets,obj.Name)
			and (obj:IsA("BasePart") or obj:IsA("Model")) then

			table.insert(result,obj)
		end
	end

	return result
end

local function teleportToTarget(target)

	local char = player.Character

	if not char or not target.Parent then
		return
	end

	local old = char:GetPivot()

	local targetCF = target:GetPivot()

	char:PivotTo(
		CFrame.new(
			targetCF.Position + Vector3.new(0,4,0)
		) * (old - old.Position)
	)

	task.wait(.7)

	if char.Parent then
		char:PivotTo(old)
	end
end

farmLoop = task.spawn(function()

	while gui.Parent do

		if farmEnabled then

			local list = getTargets()

			for _,target in ipairs(list) do

				if not farmEnabled then
					break
				end

				if target.Parent then
					teleportToTarget(target)
					task.wait(.7)
				end
			end
		end

		task.wait(.2)
	end
end)

--==================================================
-- DRAG MAIN UI
--==================================================

local dragging = false
local dragStart
local dragPosition

frame.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = true
		dragStart = input.Position
		dragPosition = frame.Position

		input.Changed:Connect(function()

			if input.UserInputState ==
				Enum.UserInputState.End then

				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if dragging and
		(input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement) then

		local delta =
			input.Position - dragStart

		frame.Position =
			UDim2.new(
				dragPosition.X.Scale,
				dragPosition.X.Offset + delta.X,
				dragPosition.Y.Scale,
				dragPosition.Y.Offset + delta.Y
			)
	end
end)

